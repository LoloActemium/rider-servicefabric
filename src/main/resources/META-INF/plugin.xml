<idea-plugin>
    <id>ch.actemium.rider.servicefabric</id>
    <name>Azure Service Fabric</name>
    <vendor>Actemium</vendor>
    <description><![CDATA[
        Package and publish Azure Service Fabric applications (<code>.sfproj</code>) from JetBrains Rider,
        without Visual Studio.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.rider</depends>

    <resource-bundle>messages.SfBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                parentId="tools"
                id="ch.actemium.rider.servicefabric.settings"
                instance="ch.actemium.rider.servicefabric.settings.SfConfigurable"
                bundle="messages.SfBundle"
                key="settings.displayName"/>
    </extensions>

    <actions>
        <group id="ServiceFabric.ProjectMenu"
               class="ch.actemium.rider.servicefabric.actions.SfProjectActionGroup"
               popup="true">
            <add-to-group group-id="SolutionExplorerPopupMenu" anchor="last"/>
            <action id="ServiceFabric.Package"
                    class="ch.actemium.rider.servicefabric.actions.SfPackagePlaceholderAction"/>
            <action id="ServiceFabric.Publish"
                    class="ch.actemium.rider.servicefabric.actions.SfPublishPlaceholderAction"/>
        </group>
    </actions>
</idea-plugin>
