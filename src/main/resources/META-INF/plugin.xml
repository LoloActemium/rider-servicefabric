<idea-plugin>
    <id>ch.actemium.rider.servicefabric</id>
    <name>Azure Service Fabric</name>
    <vendor>Actemium</vendor>
    <!-- <description> is injected at build time from docs/plugin-description.html -->

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.rider</depends>
    <depends>com.intellij.xml</depends>
    <depends>com.intellij.modules.jna</depends>

    <resource-bundle>messages.SfBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                parentId="tools"
                id="ch.actemium.rider.servicefabric.settings"
                instance="ch.actemium.rider.servicefabric.settings.SfConfigurable"
                bundle="messages.SfBundle"
                key="settings.displayName"/>
        <notificationGroup id="Service Fabric" displayType="BALLOON" bundle="messages.SfBundle"
                           key="notification.group.name"/>
        <solutionExplorerCustomization
                implementation="ch.actemium.rider.servicefabric.detection.SfSolutionExplorerCustomization"/>
        <configurationType implementation="ch.actemium.rider.servicefabric.run.SfRunConfigurationType"/>
        <programRunner implementation="ch.actemium.rider.servicefabric.run.SfRunProgramRunner"/>
        <postStartupActivity
                implementation="ch.actemium.rider.servicefabric.run.SfRunConfigurationAutoCreator$Startup"/>
        <xml.schemaProvider implementation="ch.actemium.rider.servicefabric.schema.SfSchemaProvider"/>
        <statusBarWidgetFactory id="ServiceFabricHealth"
                                implementation="ch.actemium.rider.servicefabric.health.SfHealthWidgetFactory"/>
        <postStartupActivity
                implementation="ch.actemium.rider.servicefabric.health.SfHealthWidgetFactory$Startup"/>
    </extensions>

    <projectListeners>
        <listener class="ch.actemium.rider.servicefabric.clean.SfRiderCleanListener"
                  topic="com.intellij.openapi.actionSystem.ex.AnActionListener"/>
    </projectListeners>

    <actions>
        <group id="ServiceFabric.ProjectMenu"
               class="ch.actemium.rider.servicefabric.actions.SfProjectActionGroup"
               icon="/icons/serviceFabric.svg"
               popup="true">
            <add-to-group group-id="SolutionExplorerPopupMenu" anchor="after" relative-to-action="AdvancedBuildActions"/>
            <action id="ServiceFabric.Package"
                    class="ch.actemium.rider.servicefabric.actions.SfPackageAction"
                    icon="AllIcons.Actions.Compile"/>
            <action id="ServiceFabric.Publish"
                    class="ch.actemium.rider.servicefabric.actions.SfPublishAction"
                    icon="AllIcons.Nodes.Deploy"/>
            <action id="ServiceFabric.Clean"
                    class="ch.actemium.rider.servicefabric.actions.SfCleanAction"
                    icon="AllIcons.Actions.GC"/>
            <action id="ServiceFabric.EditVersions"
                    class="ch.actemium.rider.servicefabric.actions.SfEditVersionsAction"
                    icon="AllIcons.Nodes.Tag"/>
            <action id="ServiceFabric.CreateRunConfiguration"
                    class="ch.actemium.rider.servicefabric.actions.SfCreateRunConfigurationAction"
                    icon="/icons/serviceFabric.svg"/>
            <separator/>
            <action id="ServiceFabric.RecheckEnvironment"
                    class="ch.actemium.rider.servicefabric.actions.SfRecheckEnvironmentAction"
                    icon="AllIcons.Actions.Refresh"/>
        </group>
    </actions>
</idea-plugin>
